{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARENA extension verification report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "notebook_id",
    "date_run",
    "git_commit",
    "report_inputs",
    "gt_tier",
    "evidence_level",
    "claim_scope",
    "gpu_name",
    "peak_vram_gb",
    "wall_clock_seconds",
    "models",
    "datasets",
    "tests_passed",
    "metrics",
    "baselines",
    "negative_controls",
    "ood_tests",
    "known_failures",
    "safety_notes",
    "accepted"
  ],
  "properties": {
    "notebook_id": {"type": "string", "const": "15_3_qlora_from_scratch"},
    "date_run": {"type": "string"},
    "git_commit": {"type": "string"},
    "report_inputs": {
      "type": "object",
      "required": ["schema_version", "algorithm", "combined_sha256", "files"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "algorithm": {"type": "string", "const": "sha256"},
        "combined_sha256": {"type": "string", "minLength": 1},
        "files": {"type": "array", "minItems": 1}
      }
    },
    "gt_tier": {"type": "string", "enum": ["GT-0", "GT-1", "GT-2", "GT-3", "GT-4"]},
    "evidence_level": {"type": "string"},
    "claim_scope": {"type": "string"},
    "gpu_name": {"type": "string"},
    "peak_vram_gb": {"type": "number", "minimum": 0, "maximum": 24},
    "wall_clock_seconds": {"type": "number", "minimum": 0},
    "models": {"type": "array"},
    "datasets": {"type": "array"},
    "tests_passed": {"type": "boolean"},
    "metrics": {
      "type": "object",
      "required": ["notebook_contract", "gpu_test", "gpu_evidence"],
      "properties": {
        "notebook_contract": {"type": "object"},
        "gpu_test": {
          "type": "object",
          "required": [
            "cuda_available",
            "full_path",
            "experiment_seed_count",
            "measured_seeds",
            "implementation_provenance",
            "qlora_r8_heldout_accuracy",
            "qlora_r8_two_label_conditional_nll",
            "qlora_r8_marker_swap_accuracy",
            "qlora_r8_marker_swap_flip_rate",
            "qlora_r8_marker_swap_pair_accuracy",
            "qlora_r8_marker_removed_accuracy",
            "name_only_template_transfer_accuracy",
            "qlora_r8_model_memory_mib",
            "qlora_r8_optimizer_state_mib",
            "qlora_r8_resident_training_state_mib",
            "bf16_lora_r8_resident_training_state_mib",
            "full_bf16_resident_training_state_mib",
            "same_norm_relative_error",
            "checks",
            "accepted"
          ],
          "properties": {
            "cuda_available": {"type": "boolean"},
            "full_path": {"type": "boolean"},
            "experiment_seed_count": {"type": "integer", "const": 3},
            "measured_seeds": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {"type": "integer"}
            },
            "implementation_provenance": {
              "type": "object",
              "required": ["required_policy", "all_callable", "all_code_fingerprints_present", "policy_satisfied", "functions"]
            },
            "checks": {
              "type": "object",
              "required": [
                "three_unique_measured_seed_runs",
                "seed_payloads_match_run",
                "implementation_provenance_verified",
                "student_t_uncertainty_for_n3",
                "counterbalanced_names_labels_and_templates",
                "nested_quant_state_values_exact",
                "nested_quant_state_all_finite",
                "marker_swap_accuracy_min",
                "marker_swap_flip_rate_min",
                "marker_swap_pair_accuracy_min",
                "marker_removed_accuracy_max",
                "name_only_template_transfer_is_chance",
                "total_training_state_accounting_exact",
                "qlora_total_training_state_smaller_than_bf16_lora",
                "qlora_total_training_state_smaller_than_full_bf16",
                "cuda_execution_measured",
                "full_training_path_measured"
              ]
            },
            "accepted": {"type": "boolean"}
          }
        },
        "gpu_evidence": {"type": "object"}
      }
    },
    "baselines": {"type": "object"},
    "negative_controls": {"type": "object"},
    "ood_tests": {"type": "object"},
    "known_failures": {"type": "array", "items": {"type": "string"}},
    "safety_notes": {"type": "array"},
    "accepted": {"type": "boolean"}
  }
}
