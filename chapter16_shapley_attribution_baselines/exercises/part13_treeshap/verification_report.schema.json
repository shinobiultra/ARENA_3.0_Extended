{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARENA 16.13 TreeSHAP verification report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "notebook_id",
    "date_run",
    "git_commit",
    "report_inputs",
    "gt_tier",
    "evidence_level",
    "claim_scope",
    "gpu_name",
    "peak_vram_gb",
    "wall_clock_seconds",
    "models",
    "datasets",
    "tests_passed",
    "metrics",
    "baselines",
    "negative_controls",
    "ood_tests",
    "known_failures",
    "safety_notes",
    "accepted"
  ],
  "properties": {
    "notebook_id": {
      "const": "16_13_treeshap_from_first_principles"
    },
    "date_run": {
      "type": "string",
      "minLength": 1
    },
    "git_commit": {
      "type": "string",
      "minLength": 1
    },
    "report_inputs": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "algorithm", "combined_sha256", "files"],
      "properties": {
        "schema_version": {"const": 1},
        "algorithm": {"const": "sha256"},
        "combined_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256", "size_bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "size_bytes": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "gt_tier": {
      "enum": ["GT-0", "GT-1", "GT-2", "GT-3", "GT-4"]
    },
    "evidence_level": {"type": "string", "minLength": 1},
    "claim_scope": {"type": "string", "minLength": 1},
    "gpu_name": {"type": "string"},
    "peak_vram_gb": {"type": "number", "minimum": 0, "maximum": 0},
    "wall_clock_seconds": {"type": "number", "minimum": 0},
    "models": {"type": "array", "minItems": 1},
    "datasets": {"type": "array", "minItems": 1},
    "tests_passed": {"const": true},
    "metrics": {
      "type": "object",
      "required": ["notebook_contract", "gpu_test", "gpu_evidence"],
      "properties": {
        "notebook_contract": {
          "type": "object",
          "required": ["tests_passed", "accepted", "test_count", "claim_scope"],
          "properties": {
            "tests_passed": {"const": true},
            "accepted": {"const": true},
            "test_count": {"type": "integer", "minimum": 1},
            "claim_scope": {"type": "string", "minLength": 1}
          }
        },
        "gpu_test": {
          "type": "object",
          "required": [
            "device",
            "peak_vram_gb",
            "actual_learner_passed",
            "fresh_reproduction_passed",
            "model_fits",
            "component_trees",
            "raw_interventional_reference_passed",
            "raw_interventional_reference_disclosed",
            "corrected_interventional_reference_passed"
          ],
          "properties": {
            "device": {"const": "cpu"},
            "peak_vram_gb": {"const": 0.0},
            "actual_learner_passed": {"const": true},
            "fresh_reproduction_passed": {"const": true},
            "model_fits": {"const": 18},
            "component_trees": {"const": 486},
            "raw_interventional_reference_passed": {"const": false},
            "raw_interventional_reference_disclosed": {"const": true},
            "corrected_interventional_reference_passed": {"const": true}
          }
        },
        "gpu_evidence": {"type": "object"}
      }
    },
    "baselines": {
      "type": "object",
      "required": ["declared_controls", "expected_metrics"],
      "properties": {
        "declared_controls": {"type": "array", "minItems": 1},
        "expected_metrics": {"type": "object", "minProperties": 1}
      }
    },
    "negative_controls": {"type": "object"},
    "ood_tests": {"type": "object"},
    "known_failures": {"type": "array", "maxItems": 0},
    "safety_notes": {"type": "array", "minItems": 1},
    "accepted": {"const": true}
  }
}
